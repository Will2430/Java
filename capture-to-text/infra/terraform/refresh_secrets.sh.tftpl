#!/bin/bash
# Reads the app's secrets from SSM Parameter Store into /opt/secrets.env (root only), then
# starts or updates the containers. The boot script runs it once; after changing a secret
# in SSM, run it again in the server shell:  sudo /opt/refresh-secrets.sh
# No "set -x" here: tracing would print the secrets into the logs.
set -euo pipefail
umask 077

param() {
  aws ssm get-parameter --region ${region} --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

mongo_uri=$(param ${mongo_uri_param})
stripe_secret_key=$(param ${stripe_secret_key_param})
stripe_webhook_secret=$(param ${stripe_webhook_secret_param})

cat > /opt/secrets.env <<EOF
SPRING_DATA_MONGODB_URI=$mongo_uri
STRIPE_SECRET_KEY=$stripe_secret_key
STRIPE_WEBHOOK_SECRET=$stripe_webhook_secret
EOF

# Builds the API and worker images, then starts everything. Compose recreates a container
# only if its settings changed, here the values in secrets.env.
# restart: unless-stopped brings the containers back after a stop/start.
cd /opt/app/capture-to-text
docker compose -f docker-compose.yml -f /opt/compose.server.yml up -d --build
