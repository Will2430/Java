#!/bin/bash
# Runs once, as root, on the server's first boot. Output: /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y docker git
systemctl enable --now docker

# Amazon Linux's docker package has no compose or buildx plugin, so fetch both.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-buildx \
  https://github.com/docker/buildx/releases/download/v0.17.1/buildx-v0.17.1.linux-amd64
chmod +x /usr/local/lib/docker/cli-plugins/*

git clone --depth 1 --branch ${git_ref} ${repo_url} /opt/app

cat > /opt/compose.server.yml <<'COMPOSE'
${compose_server}
COMPOSE

cat > /opt/Caddyfile <<'CADDY'
${caddyfile}
CADDY

# The realm file only allows the app's localhost address. Swap in the public one, or Keycloak
# rejects the login redirect ("Invalid redirect_uri"). It's read on Keycloak's first start.
sed -i 's|http://localhost:8080|https://${app_host}|g' \
  /opt/app/capture-to-text/config/keycloak/capture-to-text-realm.json

# Fetches the secrets and starts the containers. It's kept as a file so it can be run again
# after a secret changes in SSM.
cat > /opt/refresh-secrets.sh <<'SCRIPT'
${refresh_secrets}
SCRIPT
chmod 700 /opt/refresh-secrets.sh
/opt/refresh-secrets.sh
