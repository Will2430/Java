{
  "title": "capture-to-text",
  "uid": "capture-to-text",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "API pods up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "expr": "count(up{app=\"capture-api\"} == 1) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "stat", "title": "Worker pods up",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "expr": "count(up{app=\"capture-worker\"} == 1) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "stat", "title": "Kafka lag: messages waiting (broker-side)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "expr": "sum(kafka_topic_partition_current_offset{topic=\"capture-uploads\"}) - sum(clamp_min(kafka_consumergroup_current_offset{consumergroup=\"ocr-workers\",topic=\"capture-uploads\"}, 0))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "stat", "title": "API 5xx responses/sec",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "instant": true, "expr": "sum(rate(http_server_requests_seconds_count{app=\"capture-api\",status=~\"5..\"}[30s])) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "API requests/sec by pod (kube-proxy spread)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(http_server_requests_seconds_count{app=\"capture-api\",uri!~\"/actuator.*\"}[30s]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "API p95 latency by route",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{method}} {{uri}}", "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{app=\"capture-api\",uri!~\"/actuator.*\"}[30s])))" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "Lag by partition (broker-side)",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "partition {{partition}}", "expr": "sum by (partition) (kafka_topic_partition_current_offset{topic=\"capture-uploads\"}) - sum by (partition) (clamp_min(kafka_consumergroup_current_offset{consumergroup=\"ocr-workers\",topic=\"capture-uploads\"}, 0))" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "OCR jobs finished/sec by worker pod",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(spring_kafka_listener_seconds_count{app=\"capture-worker\"}[30s]))" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "Avg time per OCR job",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "avg", "expr": "sum(rate(spring_kafka_listener_seconds_sum{app=\"capture-worker\"}[30s])) / sum(rate(spring_kafka_listener_seconds_count{app=\"capture-worker\"}[30s]))" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "JVM process CPU by pod (fraction of the CPUs the JVM sees)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}", "expr": "process_cpu_usage{app=~\"capture-.*\"}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries", "title": "JVM heap used by pod",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (jvm_memory_used_bytes{app=~\"capture-.*\",area=\"heap\"})" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
