{
  "realm": "capture-to-text",
  "enabled": true,
  "registrationAllowed": true,
  "accessTokenLifespan": 300,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "capture-to-text-web",
      "name": "Capture to Text (browser)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8080", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "capture-to-text-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "capture-to-text-loadtest",
      "name": "k6 load test (password grant, test users only)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "capture-to-text-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "loadtest",
      "enabled": true,
      "email": "loadtest@example.com",
      "emailVerified": true,
      "firstName": "Load",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "loadtest", "temporary": false }]
    }
  ]
}
