<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.capturetotext</groupId>
    <artifactId>capture-to-text-worker</artifactId>
    <version>0.1.0</version>
    <name>capture-to-text-worker</name>
    <description>Phase 2: async OCR worker -- consumes capture-uploads from Kafka, no HTTP server</description>

    <properties>
        <java.version>17</java.version>
        <tess4j.version>5.19.0</tess4j.version>
        <minio.version>8.5.17</minio.version>
    </properties>

    <dependencies>
        <!-- Plain Spring context: this process has no HTTP endpoints, only a
             @KafkaListener bean, so spring-boot-starter-web is deliberately
             NOT a dependency here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- MongoRepository: own copy of the Capture entity/repository;
             the API module has its own. See docker-compose.yml/CLAUDE.md for
             why this duplication is intentional (two independent processes,
             no shared library between them). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Tess4J: JNA wrapper around the native Tesseract/Leptonica OCR engine.
             Moved here verbatim from the API module; OCR now only happens here. -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>

        <!-- S3-compatible client for MinIO: downloads the uploaded image by
             object key before running OCR on it. -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
